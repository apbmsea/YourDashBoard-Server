generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  createdAt     DateTime       @default(now())
  lastLoginAt   DateTime?
  refreshTokens RefreshToken[]
  deletionCodes DeletionCode[]
}

// One-time magic link. Only the SHA-256 hash of the token is stored.
// Rows double as the send log for rate limiting (by email and by IP).
model LoginToken {
  id        String    @id @default(uuid())
  email     String
  ip        String?
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
}

// Rotated on every use. A revoked row is kept until it expires so that
// a replayed (stolen) token can be detected.
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Six-digit code that confirms account deletion. Only an HMAC of the code is stored.
// Rows double as the send log for rate limiting.
model DeletionCode {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  // Wrong guesses so far; the code is dead once the limit is reached
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}
