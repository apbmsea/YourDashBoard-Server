PORT=3000
# Public URL of this API (used in Swagger and as the default magic-link target)
APP_URL=http://localhost:3000
# Frontend origins allowed by CORS, comma-separated
CORS_ORIGINS=https://localhost:3123

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/yourdashboard?schema=public

# Generate your own: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30

# Where the link from the email leads; "?token=..." is appended.
# Point it at the frontend page once there is one.
MAGIC_LINK_URL=https://localhost:3123/auth/verify
MAGIC_LINK_TTL_MINUTES=15

# Anti-spam for POST /auth/request-link
MAGIC_LINK_COOLDOWN_SECONDS=60
MAGIC_LINK_MAX_PER_EMAIL_PER_HOUR=5
MAGIC_LINK_MAX_PER_IP_PER_HOUR=20
# Number of reverse proxies (nginx etc.) in front of the API, so the per-IP limit sees the real client IP
TRUST_PROXY=0

# Real SMTP account. Port 587 = STARTTLS, 465 = TLS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password
# Optional: network adapter to send mail through, when a VPN blocks SMTP ports
# SMTP_INTERFACE=Ethernet
# Sender shown in the letter; defaults to "YourDashBoard <SMTP_USER>" when SMTP_USER is an email.
# Required for services whose login is not an email (Resend: SMTP_USER=resend, SMTP_PASS=API key);
# the address must be on a domain verified in that service.
# MAIL_FROM="YourDashBoard <you@example.com>"
